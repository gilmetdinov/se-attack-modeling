# Скопируйте в `.env` и заполните реальными значениями. Никогда не коммитьте `.env`.

# --- База данных (PostgreSQL) ---
DB_HOST=db
DB_PORT=5432
DB_USER=admin
DB_PASS=change-me
DB_NAME=attack_modeling

# --- Аутентификация ---
# Длинная случайная строка. Сгенерировать: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Legacy API key (header X-API-Key, см. dependencies.verify_api_key_header) ---
# Пустое значение отключает эту фичу.
API_KEY=

# --- CORS ---
# Разрешённые origin через запятую. "*" разрешён, но тогда credentials отключаются.
CORS_ORIGINS=http://localhost,http://localhost:80
